# ============================================================
# Astro AI Agent — environment variable reference
# Copy to .env and fill in values. All vars are optional;
# defaults are shown after '=' below.
# ============================================================

# --------------- LLM / Ollama (llm_client.py) ---------------

# Primary generation model (default: qwen2.5:7b-instruct)
ASTRO_MODEL_NAME=qwen2.5:7b-instruct

# Set to 1/true/yes to use the deep reasoning model instead
ASTRO_DEEP_MODEL=0

# Ollama request read-timeout in seconds (default: 120)
ASTRO_OLLAMA_TIMEOUT_S=120

# Context window tokens passed to Ollama (default: 16384)
ASTRO_NUM_CTX=16384

# --------------- RAG pipeline (rag_config.py) ---------------

# Enable Pydantic-schema-enforced JSON output via Ollama format= (default: 0)
# Note: disables streaming when active.
ASTRO_STRUCTURED_OUTPUT=0

# Include bhava house positions in RAG chart-facts context (default: 0)
ASTRO_USE_BHAVA_FOR_RAG=0

# Enable cross-encoder reranking of retrieved chunks (default: 0)
# Requires sentence-transformers to be installed.
ASTRO_CROSS_ENCODER_RERANK=0

# HuggingFace model id for the cross-encoder (default: cross-encoder/ms-marco-MiniLM-L-6-v2)
ASTRO_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Cross-encoder batch size (default: 16)
ASTRO_CROSS_ENCODER_BATCH_SIZE=16

# Max token length fed to cross-encoder (default: 512)
ASTRO_CROSS_ENCODER_MAX_LENGTH=512

# Weight blended back with heuristic score after cross-encoder rerank (default: 0.15)
ASTRO_CROSS_ENCODER_HEURISTIC_BLEND=0.15

# --------------- Observability (tracer.py) -------------------

# Enable JSONL request tracing (default: 0)
ASTRO_TRACE_ENABLED=0

# Path for the trace log file (default: traces.jsonl)
ASTRO_TRACE_PATH=traces.jsonl

# Path for Q&A interaction + feedback logs (default: interactions.jsonl)
ASTRO_INTERACTION_TRACE_PATH=interactions.jsonl

# Store raw birth date/time in interaction logs (default: 0; only chart fingerprint + city)
ASTRO_TRACE_STORE_BIRTH=0
